---
/**
 * 404 Not Found Page
 *
 * Custom error page displayed when a requested page doesn't exist.
 * Uses the editorial header pattern (sans kicker, serif headline, serif deck)
 * on its own, centered, with a single way back to the homepage.
 *
 * Design:
 * - No header, navigation, or footer for focused experience
 * - Colours, fonts and radii come from the shared tokens in global.css,
 *   so light and dark themes match the rest of the site
 * - Single ink CTA button to return home
 *
 * Route: /404 (automatically served for non-existent pages)
 *
 * @page
 */

import { siteConfig } from "../data/index";
import "../styles/global.css";
import "../styles/typography.css";
import "../styles/utilities.css";

const pageTitle = "404 - Page Not Found";
---

<!doctype html>
<html lang={siteConfig.language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <!-- Fonts: same families as BaseLayout (Libre Franklin + Source Serif 4) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script (prevents a flash of the wrong theme) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme = stored || "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="not-found">
    <main class="not-found__main">
      <p class="not-found__kicker">404 Error</p>

      <h1 class="not-found__title">Page Not Found</h1>

      <p class="not-found__deck">
        The page you're looking for doesn't exist or has been moved. Let's get
        you back on track.
      </p>

      <a href="/" class="btn-primary not-found__home">Back to Home</a>
    </main>
  </body>
</html>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1rem;
  }

  .not-found__main {
    width: 100%;
    max-width: var(--max-width-article);
    padding: 1.5rem 0 2rem;
    border-top: 2px solid var(--color-rule);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  .not-found__kicker {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .not-found__title {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 10vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .not-found__deck {
    max-width: 30rem;
    margin: 0 auto 2rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .not-found__main {
      padding: 2rem 0 2.5rem;
    }

    .not-found__deck {
      font-size: 1.25rem;
    }
  }
</style>
