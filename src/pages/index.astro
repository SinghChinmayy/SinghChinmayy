---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/index';

const projects = await getCollection('projects');
const featuredProjects = projects.filter((project) => project.data.featured).sort((a, b) => (a.data.order || 999) - (b.data.order || 999)).slice(0, 2);
const posts = (await getCollection('writing', ({ data }) => data.draft !== true)).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);
---

<BaseLayout>
  <SEO slot="head" title={`${siteConfig.author.name} — ${siteConfig.author.title}`} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" /><StructuredData type="Person" />
  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <img src={siteConfig.author.profilePic} alt={`${siteConfig.author.name} portrait`} class="profile-pic" />
          <p class="eyebrow">Backend · Infrastructure · Systems</p>
          <h1>I build backend systems and infrastructure.</h1>
          <p class="hero-sub">I’m an early-career software engineer and computer science student interested in how systems behave in production. I build small, explainable systems to learn by doing.</p>
          <div class="hero-cta"><a href="/projects" class="btn-primary">View projects</a><a href="/contact" class="btn-secondary">Contact</a></div>
          <SocialLinks />
        </div>
        <div class="hero-right">
          <p class="section-kicker">Selected public work</p>
          <div class="case-snapshots">
            {featuredProjects.map((project) => <a href={`/projects/${project.id}`} class="case-snapshot">
              <span class="case-label">{project.data.status === 'ongoing' ? 'In progress' : 'Case study'} · {project.data.role}</span>
              <span class="case-title">{project.data.title}</span>
              <span class="case-outcome">{project.data.outcomeSummary}</span>
              <span class="case-link">Read case study →</span>
            </a>)}
          </div>
        </div>
      </div>
    </section>

    {posts.length > 0 && <section class="recent-writing">
      <div class="section-header"><div><p class="section-kicker">Notes from the work</p><h2>Recent writing</h2></div><ForwardLink href="/blogs" text="View all" variant="muted" /></div>
      <div class="writing-grid">{posts.map((post) => <a href={`/blogs/${post.id}`} class="writing-item">
        <time class="writing-date" datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        <h3 class="writing-title">{post.data.title}</h3><p class="writing-description">{post.data.description}</p>
      </a>)}</div>
    </section>}

    <section class="cta"><p class="section-kicker">Have a thoughtful problem to discuss?</p><h2>Let’s connect.</h2><p>Open to early-career software engineering opportunities, collaborations, and conversations about systems.</p><div class="cta-buttons"><a href="/contact" class="btn-primary">Say hello</a><a href="/projects" class="btn-secondary">Browse projects</a></div></section>
  </main>
</BaseLayout>

<style>
  .home-page { max-width: var(--max-width-content); margin: 0 auto; padding: 1.5rem 1.5rem 5rem; }
  .hero { padding: 2.5rem 0 5rem; border-bottom: 1px solid var(--color-border); margin-bottom: 4rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .hero-left { max-width: 38rem; }
  .profile-pic { width: 72px; height: 72px; object-fit: cover; border: 1px solid var(--color-border); border-radius: 10px; margin-bottom: 1.5rem; }
  .eyebrow, .section-kicker, .case-label, .writing-date { color: var(--color-accent); font: 600 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 14ch; font-size: clamp(2.8rem, 6vw, 5rem); line-height: 1.02; letter-spacing: -.06em; margin: .9rem 0 1.5rem; }
  .hero-sub { max-width: 34rem; color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; }
  .hero-cta, .cta-buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.75rem; }
  .btn-primary, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: .65rem 1rem; border: 1px solid var(--color-accent); border-radius: var(--border-radius-sm); font-weight: 600; }
  .btn-primary { background: var(--color-accent); color: #fff; } .btn-primary:hover { background: var(--color-accent-hover); color: #fff; }
  .btn-secondary { color: var(--color-text); border-color: var(--color-border); background: var(--color-bg-secondary); } .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .hero-right { padding-top: .5rem; } .case-snapshots { display: grid; gap: 1rem; margin-top: 1rem; }
  .case-snapshot { display: block; padding: 1.35rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); box-shadow: var(--shadow-sm); }
  .case-snapshot:hover { border-color: var(--color-accent); } .case-label { display: block; }
  .case-title { display: block; color: var(--color-text); font-size: 1.15rem; font-weight: 700; margin: .6rem 0 .5rem; }
  .case-outcome { display: block; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 1rem; } .case-link { color: var(--color-accent); font-size: .875rem; font-weight: 600; }
  .section-header { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.25rem; } h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-top: .4rem; }
  .writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } .writing-item { display: block; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); }
  .writing-item:hover { border-color: var(--color-accent); } .writing-title { color: var(--color-text); font-size: 1.05rem; line-height: 1.35; margin: .7rem 0 .5rem; } .writing-description { color: var(--color-text-secondary); font-size: .925rem; line-height: 1.55; }
  .cta { margin-top: 4rem; padding: 2.5rem clamp(1.25rem, 4vw, 3rem); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); } .cta h2 { margin-bottom: .75rem; } .cta > p:not(.section-kicker) { max-width: 36rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
  @media (max-width: 768px) { .home-page { padding-inline: 1rem; } .hero-grid { grid-template-columns: 1fr; gap: 3rem; } h1 { max-width: 12ch; font-size: clamp(2.7rem, 13vw, 4.3rem); } .writing-grid { grid-template-columns: 1fr; } }
</style>
