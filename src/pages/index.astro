---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/index';

const projects = await getCollection('projects');
const featuredProjects = projects.filter((project) => project.data.featured).sort((a, b) => (a.data.order || 999) - (b.data.order || 999)).slice(0, 2);
const posts = (await getCollection('writing', ({ data }) => data.draft !== true)).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);
const shorten = (text: string, maxLength = 180) => text.length > maxLength ? `${text.slice(0, maxLength - 1).trimEnd()}…` : text;
const techStack = Array.from(new Set([
  ...projects.flatMap((project) => project.data.techStack),
  'C++',
  'Data structures & algorithms',
]));
const techIcons: Record<string, string> = {
  Go: 'go', Python: 'python', Flutter: 'flutter', Dart: 'dart', PostgreSQL: 'postgresql',
  'Supabase (Auth + Postgres)': 'supabase', 'drift / SQLite': 'sqlite', Provider: 'flutter',
  'REST / JSON': 'json', Prometheus: 'prometheus', OpenTelemetry: 'opentelemetry',
  'Background workers': 'go', 'Row Level Security': 'postgresql', Regex: 'python',
  pathlib: 'python', 'Unicode (NFKC)': 'python', 'C++': 'cplusplus',
  'Data structures & algorithms': 'cplusplus',
};
const techGroups = [
  { label: 'Languages', technologies: ['Go', 'Python', 'C++', 'Dart'] },
  { label: 'Application', technologies: ['Flutter', 'Provider'] },
  { label: 'Backend & data', technologies: ['REST / JSON', 'PostgreSQL', 'Supabase (Auth + Postgres)', 'drift / SQLite', 'Row Level Security'] },
  { label: 'Reliability', technologies: ['Prometheus', 'OpenTelemetry', 'Background workers'] },
  { label: 'Foundations', technologies: ['Regex', 'pathlib', 'Unicode (NFKC)'] },
  { label: 'Problem solving', technologies: ['Data structures & algorithms'] },
];
---

<BaseLayout>
  <SEO slot="head" title={`${siteConfig.author.name} — ${siteConfig.author.title}`} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" /><StructuredData type="Person" />
  <main class="home-page">
    <div class="hero-shell">
      <section class="hero">
        <div class="hero-left">
          <img src={siteConfig.author.profilePic} alt={`${siteConfig.author.name} portrait`} class="profile-pic" />
          <p class="eyebrow">Backend · Infrastructure · Systems</p>
          <h1>I build backend systems and infrastructure.</h1>
          <p class="hero-sub">Early-career software engineer and computer science student building backend systems, infrastructure, and developer tools.</p>
          <div class="hero-cta"><a href="/projects" class="btn-primary">View projects</a><a href="/contact" class="btn-secondary">Contact</a></div>
          <div class="profile-actions">
            <SocialLinks excludePlatforms={['leetcode']} />
            <a class="profile-link" href="https://leetcode.com/u/SinghChinmayy/" target="_blank" rel="noopener noreferrer">LeetCode profile <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="selected-work" aria-labelledby="selected-work-heading">
        <p class="section-kicker" id="selected-work-heading">Selected public work</p>
        <div class="case-snapshots">
          {featuredProjects.map((project) => <a href={`/projects/${project.id}`} class="case-snapshot">
            <span class="case-label">{project.data.status === 'ongoing' ? 'In progress' : 'Case study'} · {project.data.role}</span>
            <span class="case-title">{project.data.title}</span>
            <span class="case-outcome">{shorten(project.data.outcomeSummary)}</span>
            <span class="case-link">Read case study →</span>
          </a>)}
        </div>
      </section>
    </div>

    <section class="stack-section" aria-labelledby="stack-heading">
      <div class="section-header stack-header">
        <div><p class="section-kicker">Tools I use to learn by building</p><h2 id="stack-heading">Tools &amp; practice</h2></div>
      </div>
      <div class="stack-groups">
        {techGroups.map((group) => {
          const technologies = group.technologies.filter((technology) => techStack.includes(technology));
          return technologies.length > 0 && <div class="stack-group">
            <h3 class="stack-group-title">{group.label}</h3>
            <div class="stack-list">
              {technologies.map((technology) => <span class="stack-item">
                {techIcons[technology] && <img class="stack-icon" src={`https://cdn.simpleicons.org/${techIcons[technology]}/276EF1`} alt="" loading="lazy" />}
                {technology}
              </span>)}
            </div>
          </div>;
        })}
      </div>
    </section>

    {posts.length > 0 && <section class="recent-writing">
      <div class="section-header"><div><p class="section-kicker">Notes from the work</p><h2>Recent writing</h2></div><ForwardLink href="/blogs" text="View all" variant="muted" /></div>
      <div class="writing-grid">{posts.map((post) => <a href={`/blogs/${post.id}`} class="writing-item">
        <time class="writing-date" datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        <h3 class="writing-title">{post.data.title}</h3><p class="writing-description">{shorten(post.data.description, 150)}</p>
      </a>)}</div>
    </section>}

    <section class="cta"><p class="section-kicker">Have a thoughtful problem to discuss?</p><h2>Let’s connect.</h2><p>Open to early-career software engineering opportunities, collaborations, and conversations about systems.</p><div class="cta-buttons"><a href="/contact" class="btn-primary">Say hello</a><a href="/projects" class="btn-secondary">Browse projects</a></div></section>
  </main>
</BaseLayout>

<style>
  .home-page { max-width: var(--max-width-content); margin: 0 auto; padding: .75rem 1rem 4rem; }
  .hero-shell { display: grid; gap: 2.5rem; }
  .hero { padding: 1.25rem 0 2.5rem; border-bottom: 1px solid var(--color-border); }
  .hero-left { max-width: 38rem; }
  .profile-pic { width: 64px; height: 64px; object-fit: cover; border: 1px solid var(--color-border); border-radius: 10px; margin-bottom: 1.25rem; }
  .eyebrow, .section-kicker, .case-label, .writing-date { color: var(--color-accent); font: 600 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 14ch; font-size: clamp(2.35rem, 11vw, 5rem); line-height: 1.04; letter-spacing: -.06em; margin: .8rem 0 1.25rem; }
  .hero-sub { max-width: 34rem; color: var(--color-text-secondary); font-size: 1rem; line-height: 1.65; margin-bottom: 1.5rem; }
  .hero-cta, .cta-buttons { display: flex; flex-wrap: wrap; gap: .65rem; margin-bottom: 1.5rem; }
  .profile-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .profile-link { color: var(--color-text-secondary); font-size: .875rem; font-weight: 600; }
  .profile-link:hover { color: var(--color-accent); }
  .btn-primary, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 2.875rem; padding: .7rem 1rem; border: 1px solid var(--color-accent); border-radius: var(--border-radius-sm); font-weight: 600; }
  .btn-primary { background: var(--color-accent); color: #fff; } .btn-primary:hover { background: var(--color-accent-hover); color: #fff; }
  .btn-secondary { color: var(--color-text); border-color: var(--color-border); background: var(--color-bg-secondary); } .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .selected-work { padding-top: 0; } .case-snapshots { display: grid; gap: 1rem; margin-top: 1rem; }
  .case-snapshot { display: block; padding: 1.35rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); box-shadow: var(--shadow-sm); }
  .case-snapshot:hover { border-color: var(--color-accent); } .case-label { display: block; }
  .case-title { display: block; color: var(--color-text); font-size: 1.15rem; font-weight: 600; margin: .6rem 0 .5rem; }
  .case-outcome { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 1rem; } .case-link { color: var(--color-accent); font-size: .875rem; font-weight: 600; }
  .section-header { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.25rem; } h2 { font-size: clamp(1.8rem, 8vw, 2.5rem); margin-top: .4rem; }
  .stack-section { margin-bottom: 3rem; padding-bottom: 3rem; border-bottom: 1px solid var(--color-border); }
  .stack-header { margin-bottom: 1rem; }
  .stack-groups { display: grid; gap: 1rem; }
  .stack-group-title { margin-bottom: .6rem; color: var(--color-text-muted); font: 600 .7rem/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .stack-list { display: flex; flex-wrap: wrap; gap: .55rem; }
  .stack-item { display: inline-flex; align-items: center; min-height: 2.5rem; padding: .45rem .75rem .45rem .45rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); background: var(--color-bg-secondary); color: var(--color-text-secondary); font-size: .875rem; }
  .stack-icon { width: 1.7rem; height: 1.7rem; margin-right: .55rem; object-fit: contain; }
  .writing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } .writing-item { display: block; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); }
  .writing-item:hover { border-color: var(--color-accent); } .writing-title { color: var(--color-text); font-size: 1.05rem; line-height: 1.35; margin: .7rem 0 .5rem; } .writing-description { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; color: var(--color-text-secondary); font-size: .925rem; line-height: 1.55; }
  .cta { margin-top: 3rem; padding: 1.75rem 1.15rem; border: 1px solid var(--color-border); border-radius: var(--border-radius-md); background: var(--color-bg-secondary); } .cta h2 { margin-bottom: .75rem; } .cta > p:not(.section-kicker) { max-width: 36rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
  @media (max-width: 420px) { .hero-cta a, .cta-buttons a { flex: 1 1 0; min-width: 0; padding-inline: .75rem; } .profile-actions { align-items: flex-start; flex-direction: column; gap: .75rem; } .case-snapshot, .writing-item { padding: 1rem; } .case-outcome { -webkit-line-clamp: 3; } .stack-item { max-width: 100%; font-size: .8125rem; } }
  @media (min-width: 769px) { .home-page { padding: 1.5rem 1.5rem 5rem; } .hero-shell { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; } .hero { padding: 2.5rem 0 5rem; margin-bottom: 0; } .selected-work { padding-top: 3rem; } .profile-pic { width: 72px; height: 72px; margin-bottom: 1.5rem; } h1 { font-size: clamp(2.8rem, 6vw, 5rem); } .hero-sub { font-size: 1.1rem; } .stack-section { margin-bottom: 4rem; padding-bottom: 4rem; } .writing-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .cta { margin-top: 4rem; padding: 2.5rem clamp(1.25rem, 4vw, 3rem); } }
</style>
