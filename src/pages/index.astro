---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import ProjectIndexItem from '../components/ProjectIndexItem.astro';
import agentSkills from '../data/agentSkills.json';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/index';
import awsBadge from '../assets/Certifications/AWS/aws-academy-graduate-cloud-foundations-training-bad.png';
import awsCertificate from '../assets/Certifications/AWS/AWS_Academy_Graduate___Cloud_Foundations___Training_Badge_Badge20260716-8-2s66j3.pdf';
import ibmCertificate from '../assets/Certifications/IBMDesign20260915-20-xfmpjj.pdf';
import amfiCertificate from '../assets/Certifications/AMFI_INDIA/1749477044045.jpeg';
import courseraDigitalSystems from '../assets/Certifications/Coursera/CERTIFICATE_LANDING_PAGE~BNXSSGE9Z7UW.jpeg';
import courseraJava from '../assets/Certifications/Coursera/CERTIFICATE_LANDING_PAGE~489ZTO7YQW2I.jpeg';
import courseraDataStructures from '../assets/Certifications/Coursera/CERTIFICATE_LANDING_PAGE~9LFD9JPQKOQT.jpeg';
import courseraLinearRegression from '../assets/Certifications/Coursera/1755159608816.jpeg';
import courseraC from '../assets/Certifications/Coursera/Coursera 9P5E3RK9UJLU.pdf';
import courseraDocker from '../assets/Certifications/Coursera/Coursera 2G6SK49FW4BU.pdf';
import ibmIot from '../assets/Certifications/IBM-skill_build/1755457040788.jpeg';
import ibmBedrock from '../assets/Certifications/IBM-skill_build/1755457171782.jpeg';
import ibmAgenticAi from '../assets/Certifications/IBM-skill_build/1755457363567.jpeg';
import ibmRag from '../assets/Certifications/IBM-skill_build/1755457475189.jpeg';
import ibmGranite from '../assets/Certifications/IBM-skill_build/1755457609740.jpeg';
import ibmOpenSearch from '../assets/Certifications/IBM-skill_build/1755457677750.jpeg';
import ibmAiAgents from '../assets/Certifications/IBM-skill_build/1755457865036.jpeg';
import bootDevLinux from '../assets/Certifications/boot.dev/ac713580-a863-4970-968a-0a3281207d56.jpeg';
import bootDevPython from '../assets/Certifications/boot.dev/bdeedf6a-e1ef-4174-86d4-707cdfd094a6.jpeg';

const projects = await getCollection('projects');
const featuredProjects = projects.filter((project) => project.data.featured).sort((a, b) => (a.data.order || 999) - (b.data.order || 999)).slice(0, 2);
const currentProject = featuredProjects[0];
const allPosts = (await getCollection('writing', ({ data }) => data.draft !== true)).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const posts = allPosts.slice(0, 3);
const teaserSkills = ['tdd-red-green-refactor', 'grill-me', 'engineering-notes']
  .map((name) => agentSkills.skills.find((skill) => skill.name === name))
  .filter((skill) => skill !== undefined);
const numbers = [
  { value: String(projects.length), label: 'public case studies' },
  { value: '221', label: 'tests in my latest build' },
  { value: String(agentSkills.skills.length), label: 'open-source agent skills' },
  { value: String(allPosts.length), label: 'articles on what I learned' },
];
const githubProfile = siteConfig.social.find(({ platform }) => platform === 'github')?.url ?? 'https://github.com/SinghChinmayy';
const githubUsername = githubProfile.split('/').filter(Boolean).pop() ?? 'SinghChinmayy';
const shorten = (text: string, maxLength = 180) => text.length > maxLength ? `${text.slice(0, maxLength - 1).trimEnd()}…` : text;
const techIcons: Record<string, string> = {
  Go: 'go', Python: 'python', Flutter: 'flutter', Dart: 'dart', PostgreSQL: 'postgresql',
  Supabase: 'supabase', SQLite: 'sqlite', 'Supabase (Auth + Postgres)': 'supabase', 'drift / SQLite': 'sqlite', Provider: 'flutter',
  'REST / JSON': 'json', Prometheus: 'prometheus', OpenTelemetry: 'opentelemetry',
  'Background workers': 'go', 'Row Level Security': 'postgresql', Regex: 'python',
  pathlib: 'python', 'Unicode (NFKC)': 'python', 'C++': 'cplusplus', C: 'c', Java: 'java',
  AWS: 'amazonaws', Docker: 'docker', Linux: 'linux', OpenSearch: 'opensearch',
  'IBM Granite': 'ibm', IoT: 'arduino',
};
const logoTechnologies = new Set([
  'Go', 'Python', 'C++', 'Java', 'PostgreSQL', 'Supabase', 'SQLite',
  'AWS', 'Docker', 'Linux', 'Prometheus', 'OpenTelemetry', 'OpenSearch',
]);
const techIconUrls: Record<string, string> = {
  Java: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg',
  AWS: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg',
};
const techGroups = [
  { label: 'Languages', technologies: ['Go', 'Python', 'C++', 'Java'] },
  { label: 'Backend & Data', technologies: ['REST / JSON', 'PostgreSQL', 'Supabase', 'SQLite'] },
  { label: 'Infrastructure', technologies: ['AWS', 'Docker', 'Linux', 'Background workers'] },
  { label: 'Observability', technologies: ['Prometheus', 'OpenTelemetry'] },
  { label: 'AI & Foundations', technologies: ['Amazon Bedrock', 'OpenSearch', 'RAG', 'Data structures & algorithms'] },
];
const certifications = [
  {
    issuer: 'AWS Academy',
    title: 'Graduate — Cloud Foundations',
    date: '2026',
    description: 'Training badge covering foundational cloud concepts and AWS services.',
    preview: awsBadge.src,
    certificate: awsCertificate,
    alt: 'AWS Academy Graduate Cloud Foundations badge',
  },
  {
    issuer: 'IBM SkillsBuild',
    title: 'Web Development Fundamentals',
    date: '2026',
    description: 'Digital credential covering foundational web development concepts.',
    certificate: ibmCertificate,
    alt: 'IBM SkillsBuild Web Development Fundamentals certificate',
  },
  { issuer: 'AMFI India', title: 'AMFI Registered Mutual Fund Distributor', date: '2024', description: 'Registration card issued by the Association of Mutual Funds in India.', preview: amfiCertificate.src, certificate: amfiCertificate.src, alt: 'AMFI Registered Mutual Fund Distributor card' },
  { issuer: 'Coursera · UAB', title: 'Digital Systems: From Logic Gates to Processors', date: '2024', description: 'Online course authorized by Universitat Autònoma de Barcelona.', preview: courseraDigitalSystems.src, certificate: courseraDigitalSystems.src, alt: 'Coursera Digital Systems certificate' },
  { issuer: 'Coursera · University of Pennsylvania', title: 'Introduction to Java and Object-Oriented Programming', date: '2024', description: 'Online non-credit course offered through Coursera.', preview: courseraJava.src, certificate: courseraJava.src, alt: 'Coursera Introduction to Java certificate' },
  { issuer: 'Coursera · University of Illinois', title: 'Ordered Data Structures', date: '2024', description: 'Online course in computer science and data structures.', preview: courseraDataStructures.src, certificate: courseraDataStructures.src, alt: 'Coursera Ordered Data Structures certificate' },
  { issuer: 'Coursera Project Network', title: 'Linear Regression with Python', date: '2025', description: 'Hands-on project certificate in Python and machine learning.', preview: courseraLinearRegression.src, certificate: courseraLinearRegression.src, alt: 'Coursera Linear Regression with Python certificate' },
  { issuer: 'Coursera Project Network', title: 'Learn Fundamentals of Computer Programming with C Language', date: '2024', description: 'Guided project certificate in C programming fundamentals.', certificate: courseraC, alt: 'Coursera C programming certificate' },
  { issuer: 'Coursera Project Network', title: 'Docker for Absolute Beginners', date: '2024', description: 'Guided project certificate covering Docker fundamentals.', certificate: courseraDocker, alt: 'Coursera Docker certificate' },
  { issuer: 'IBM SkillsBuild', title: 'Workshop on Connecting to IoT by IBMer', date: '2025', description: 'Completion certificate for an IBM SkillsBuild workshop.', preview: ibmIot.src, certificate: ibmIot.src, alt: 'IBM SkillsBuild Connecting to IoT certificate' },
  { issuer: 'IBM SkillsBuild', title: 'AWS Lab — Bedrock Agent Integration via API', date: '2025', description: 'Completion certificate for an applied AWS Bedrock lab.', preview: ibmBedrock.src, certificate: ibmBedrock.src, alt: 'IBM SkillsBuild AWS Bedrock certificate' },
  { issuer: 'IBM SkillsBuild', title: 'AWS Lab — Agentic AI', date: '2025', description: 'Completion certificate for an applied agentic AI lab.', preview: ibmAgenticAi.src, certificate: ibmAgenticAi.src, alt: 'IBM SkillsBuild Agentic AI certificate' },
  { issuer: 'IBM SkillsBuild', title: 'Unleashing the Power of AI Agents', date: '2025', description: 'Completion certificate for an AI agents learning course.', preview: ibmAiAgents.src, certificate: ibmAiAgents.src, alt: 'IBM SkillsBuild AI Agents certificate' },
  { issuer: 'IBM SkillsBuild', title: 'Introduction to Retrieval Augmented Generation', date: '2025', description: 'Completion certificate covering RAG concepts and workflows.', preview: ibmRag.src, certificate: ibmRag.src, alt: 'IBM SkillsBuild RAG certificate' },
  { issuer: 'IBM SkillsBuild', title: 'Classifying Data Using IBM Granite', date: '2025', description: 'Completion certificate for a data classification course.', preview: ibmGranite.src, certificate: ibmGranite.src, alt: 'IBM SkillsBuild IBM Granite certificate' },
  { issuer: 'IBM SkillsBuild', title: 'Building RAG Workflows with Amazon OpenSearch Service', date: '2025', description: 'Completion certificate for an applied RAG and OpenSearch course.', preview: ibmOpenSearch.src, certificate: ibmOpenSearch.src, alt: 'IBM SkillsBuild Amazon OpenSearch certificate' },
  { issuer: 'Boot.dev', title: 'Learn Linux', date: '2025', description: 'Certificate of completion for Boot.dev’s Linux course.', preview: bootDevLinux.src, certificate: bootDevLinux.src, alt: 'Boot.dev Learn Linux certificate' },
  { issuer: 'Boot.dev', title: 'Learn to Code in Python', date: '2025', description: 'Certificate of completion for Boot.dev’s Python course.', preview: bootDevPython.src, certificate: bootDevPython.src, alt: 'Boot.dev Learn to Code in Python certificate' },
];
const featuredCertificationTitles = new Set([
  'Graduate — Cloud Foundations',
  'Web Development Fundamentals',
  'Digital Systems: From Logic Gates to Processors',
  'Ordered Data Structures',
  'Linear Regression with Python',
  'Docker for Absolute Beginners',
]);
const featuredCertifications = certifications.filter(({ title }) => featuredCertificationTitles.has(title));
const otherCertifications = certifications.filter(({ title }) => !featuredCertificationTitles.has(title));
const certificationCategory = (title: string) => {
  if (/AWS|Docker|Linux/.test(title)) return 'Cloud & DevOps';
  if (/Linear Regression|RAG|Agent|Granite/.test(title)) return 'AI & Data';
  if (/Web Development|Digital Systems|Java|Data Structures|C Language|Python/.test(title)) return 'Software Development';
  return 'Other Professional Credentials';
};
const certificationCategories = ['Cloud & DevOps', 'AI & Data', 'Software Development', 'Other Professional Credentials']
  .map((label) => ({ label, items: otherCertifications.filter(({ title }) => certificationCategory(title) === label) }))
  .filter(({ items }) => items.length > 0);
---

<BaseLayout>
  <SEO slot="head" title={`${siteConfig.author.name} — ${siteConfig.author.title}`} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" /><StructuredData type="Person" />
  <main class="home-page">
    <div class="hero-shell">
      <section class="hero">
        <div class="hero-left">
          <p class="eyebrow">Backend engineering · Systems · Infrastructure</p>
          <h1>Backend systems, built to be understood.</h1>
          <p class="hero-sub">I build APIs, data flows, and operational tooling that make software more reliable and easier to reason about.</p>
          <p class="hero-personal">I like writing the failing test first, keeping a record of why each decision was made, and leaving systems easier to change than I found them.</p>
          <div class="hero-cta"><a href="/projects" class="btn-primary">View selected work <span aria-hidden="true">→</span></a><a class="profile-link btn-secondary" href={githubProfile} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="hero-portrait">
          <img src={siteConfig.author.profilePic} alt="Portrait of Chinmay Singh" width="480" height="600" fetchpriority="high" />
          <figcaption>{siteConfig.author.name} · {siteConfig.author.location}</figcaption>
        </figure>
      </section>
    </div>

    {currentProject && <a href={`/projects/${currentProject.id}`} class="now-building">
      <span class="now-label"><span class="now-dot" aria-hidden="true"></span>Now building</span>
      <span class="now-title">{currentProject.data.title}</span>
      <span class="now-description">An auditable workflow for detecting service failures, proposing safe remediation, requiring human approval, and verifying recovery.</span>
      <span class="now-link">Read the case study <span aria-hidden="true">→</span></span>
    </a>}

    <section class="about-section" aria-labelledby="about-heading">
      <div class="section-header"><p class="section-kicker">About</p></div>
      <div class="about-grid">
      <div class="about-copy">
        <h2 id="about-heading">I learn systems by making their boundaries explicit.</h2>
        <p>I’m Chinmay, a software engineer focused on backend development, infrastructure, and the practical details that make software dependable. I like working from a clear model of the data, the failure modes, and the evidence a system should leave behind.</p>
        <p>Most of my work is self-directed and public: small, explainable systems that help me turn concepts into working code and better engineering judgment.</p>
        <p class="about-exploring"><span>Currently exploring</span> Go services, operational workflows, and reliable data synchronization.</p>
      </div>
      </div>
    </section>

    <section class="numbers" aria-labelledby="numbers-heading">
      <div class="section-header"><p class="section-kicker" id="numbers-heading">By the numbers</p></div>
      <ul class="numbers-grid">
        {numbers.map((item) => <li class="number-cell">
          <span class="number-value">{item.value}</span>
          <span class="number-label">{item.label}</span>
        </li>)}
      </ul>
    </section>

    <section class="selected-projects" aria-labelledby="selected-projects-heading">
      <div class="section-header">
        <p class="section-kicker">Selected work</p>
        <ForwardLink href="/projects" text="View all" variant="muted" />
      </div>
      <h2 class="section-title" id="selected-projects-heading">Projects</h2>
      <div class="project-home-list">
        {featuredProjects.map((project, index) => <ProjectIndexItem
          number={String(index + 1).padStart(2, '0')}
          title={project.data.title}
          slug={project.id}
          summary={shorten(project.data.outcomeSummary, 220)}
          year={project.data.year}
          status={project.data.status}
          techStack={project.data.techStack}
        />)}
      </div>
    </section>

    <section class="skills-teaser" aria-labelledby="skills-heading">
      <div class="section-header">
        <p class="section-kicker">Open source</p>
        <ForwardLink href="/agent-skills" text="All skills" variant="muted" />
      </div>
      <h2 class="section-title" id="skills-heading">Skills for your coding agent</h2>
      <p class="section-deck">The instructions I give Claude Code and Codex, packaged so you can install them with one command.</p>
      <ul class="skills-list">
        {teaserSkills.map((skill) => <li>
          <a class="skill-row" href={`/agent-skills#${skill.name}`}>
            <span class="skill-row-title">{skill.title}</span>
            <span class="skill-row-summary">{skill.summary.split('. ')[0].replace(/\.$/, '')}.</span>
          </a>
        </li>)}
      </ul>
      <p class="skills-install"><span>Try one:</span> <code>npx skills add {agentSkills.repo} --skill grill-me</code></p>
    </section>

    <section class="stack-section" aria-labelledby="stack-heading">
      <div class="section-header stack-header">
        <p class="section-kicker">Tools I use to learn by building</p>
      </div>
      <h2 class="section-title" id="stack-heading">Tools &amp; practice</h2>
      <div class="stack-groups">
        {techGroups.map((group) => {
          return <div class="stack-group">
            <h3 class="stack-group-title">{group.label}</h3>
            <p class="stack-values">
              {group.technologies.map((technology, index) => <>
                <span class="stack-value">
                  {logoTechnologies.has(technology) && (techIconUrls[technology] || techIcons[technology]) && <img class="stack-icon" src={techIconUrls[technology] || `https://cdn.simpleicons.org/${techIcons[technology]}/276EF1`} alt="" loading="lazy" />}
                  {technology}
                </span>{index < group.technologies.length - 1 && <span class="stack-separator" aria-hidden="true">·</span>}
              </>)}
            </p>
          </div>;
        })}
      </div>
    </section>

    <section class="certifications-section" aria-labelledby="certifications-heading">
      <div class="section-header">
        <p class="section-kicker">Selected credentials</p>
      </div>
      <h2 class="section-title" id="certifications-heading">Certifications</h2>
      <p class="certification-subtitle">Selected credentials and technical coursework.</p>
      <div class="certifications-table">
        <div class="certifications-table-header" aria-hidden="true"><span>Certificate</span><span>Issuer</span><span>Year / View</span></div>
        {featuredCertifications.map((certification) => <a class="certification-item" href={certification.certificate} target="_blank" rel="noopener noreferrer">
          <span class="certification-name">{certification.title}</span>
          <span class="certification-issuer">{certification.issuer}</span>
          <span class="certification-action"><time>{certification.date}</time><span class="certification-link" aria-label={`View ${certification.title} certificate`}>View ↗</span></span>
        </a>)}
      </div>
      {otherCertifications.length > 0 && <div class="certifications-more">
        <button class="certifications-toggle" type="button" aria-expanded="false" aria-controls="all-certifications">
          <span data-certifications-label>View all certifications</span> <span aria-hidden="true" data-certifications-icon>↓</span>
        </button>
        <div class="certifications-list" id="all-certifications" data-certifications-list hidden>
          {certificationCategories.map((category) => <section class="certification-category" aria-labelledby={`category-${category.label.toLowerCase().replaceAll(' ', '-')}`}>
            <h3 id={`category-${category.label.toLowerCase().replaceAll(' ', '-')}`}>{category.label}</h3>
            <div class="certification-category-table">
              {category.items.map((certification) => <a class="certification-item" href={certification.certificate} target="_blank" rel="noopener noreferrer">
                <span class="certification-name">{certification.title}</span>
                <span class="certification-issuer">{certification.issuer}</span>
                <span class="certification-action"><time>{certification.date}</time><span class="certification-link" aria-label={`View ${certification.title} certificate`}>View ↗</span></span>
              </a>)}
            </div>
          </section>)}
        </div>
      </div>}
    </section>

    {posts.length > 0 && <section class="recent-writing">
      <div class="section-header"><p class="section-kicker">Notes from the work</p><ForwardLink href="/blogs" text="View all" variant="muted" /></div>
      <h2 class="section-title">Recent writing</h2>
      <div class="writing-grid">{posts.map((post) => <a href={`/blogs/${post.id}`} class="writing-item">
        <time class="writing-date" datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        <h3 class="writing-title">{post.data.title}</h3><p class="writing-description">{shorten(post.data.description, 150)}</p>
      </a>)}</div>
    </section>}

    <section class="activity-section" aria-labelledby="activity-heading">
      <div class="section-header activity-header">
        <p class="section-kicker">Building in public</p>
        <a class="activity-link" href={githubProfile} target="_blank" rel="noopener noreferrer">View profile <span aria-hidden="true">↗</span></a>
      </div>
      <h2 class="section-title" id="activity-heading">GitHub activity</h2>
      <a class="activity-heatmap" href={githubProfile} target="_blank" rel="noopener noreferrer" aria-label={`View ${githubUsername}'s GitHub contribution activity`}>
        <img src={`https://ghchart.rshah.org/326891/${githubUsername}`} alt={`GitHub contribution heatmap for ${githubUsername}`} loading="lazy" />
      </a>
    </section>

    <section class="cta"><div class="section-header"><p class="section-kicker">Have a thoughtful problem to discuss?</p></div><h2>Let’s connect.</h2><p>Open to early-career software engineering opportunities, collaborations, and conversations about systems.</p><div class="cta-buttons"><a href="/contact" class="btn-primary">Say hello</a><a href="/projects" class="btn-secondary">Browse projects</a></div></section>
  </main>
</BaseLayout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.certifications-toggle');
  const list = document.querySelector<HTMLElement>('[data-certifications-list]');
  const label = document.querySelector<HTMLElement>('[data-certifications-label]');
  const icon = document.querySelector<HTMLElement>('[data-certifications-icon]');

  toggle?.addEventListener('click', () => {
    if (!list || !label || !icon) return;
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    label.textContent = isExpanded ? 'View all certifications' : 'Show less';
    icon.textContent = isExpanded ? '↓' : '↑';

    if (isExpanded) {
      list.classList.remove('is-expanded');
      window.setTimeout(() => list.setAttribute('hidden', ''), 240);
    } else {
      list.removeAttribute('hidden');
      requestAnimationFrame(() => list.classList.add('is-expanded'));
    }
  });
</script>

<style>
  /* Front-page layout: section labels over heavy ink rules, items between hairlines. */
  .home-page {
    width: min(100%, var(--max-width-content));
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem) 4rem;
  }

  /* ---------- Shared editorial pieces ---------- */
  .eyebrow,
  .section-kicker,
  .project-status {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--color-rule);
  }

  .section-header :global(.arrow-link) {
    min-height: 2.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .section-title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    border: 1px solid var(--color-text);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: none;
  }

  /* Primary = ink button. */
  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
    color: var(--color-bg);
  }

  /* Secondary = outline on paper. */
  .btn-secondary {
    background: transparent;
    color: var(--color-text);
  }

  .btn-secondary:hover {
    background: transparent;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-cta,
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(1rem, 3vw, 1.5rem);
  }

  .hero-left {
    max-width: 44rem;
  }

  .hero h1 {
    max-width: 20ch;
    margin: 0.875rem 0 1rem;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-personal {
    max-width: 36rem;
    margin-bottom: 1.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .hero-portrait {
    width: min(100%, 11rem);
    margin: 0;
  }

  @media (min-width: 900px) {
    .hero-portrait {
      width: 100%;
    }
  }

