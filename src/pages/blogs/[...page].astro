---
/**
 * Blog Index Page with Pagination
 *
 * Lists all published articles (excluding drafts) with pagination support. Displays
 * compact editorial entries with title, description, publish date, and topics. Uses a rest parameter
 * route to handle both the first page (/blogs) and subsequent pages (/blogs/2, etc.).
 *
 * Features:
 * - Filters out draft articles (only shows published content)
 * - Sorts by publish date (descending - newest first)
 * - Pagination with 5 articles per page
 * - Dynamic page statistics showing current range
 * - SEO optimization per page
 * - Empty state handling
 *
 * Routes:
 * - /blogs (page 1)
 * - /blogs/2 (page 2)
 * - /blogs/3 (page 3)
 * - etc.
 *
 * @page
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SEO from "../../components/SEO.astro";
import Pagination from "../../components/Pagination.astro";
import ArticleIndexItem from "../../components/ArticleIndexItem.astro";
import { getCollection } from "astro:content";
import { pagesConfig } from "../../pages.config";
import type { GetStaticPaths } from "astro";

/**
 * Generates static paths for all paginated pages
 *
 * Queries published articles (draft: false), sorts by date, and creates
 * pagination paths. Page 1 uses undefined param to match /blogs route,
 * while subsequent pages use numeric params (/blogs/2, /blogs/3, etc.).
 *
 * @returns Array of path objects with params and props for each page
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const postsPerPage = 5;

  const allArticles = await getCollection("writing", ({ data }) => {
    return data.draft === false;
  });

  // Sort by publishDate (descending - most recent first)
  const sortedArticles = allArticles.sort((a, b) => {
    return b.data.publishDate.getTime() - a.data.publishDate.getTime();
  });

  const totalPages = Math.ceil(sortedArticles.length / postsPerPage);

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    const start = i * postsPerPage;
    const end = start + postsPerPage;

    return {
      params: { page: page === 1 ? undefined : String(page) },
      props: {
        articles: sortedArticles.slice(start, end),
        currentPage: page,
        totalPages,
        totalArticles: sortedArticles.length,
      },
    };
  });
};

interface Props {
  /** Articles for the current page */
  articles: Awaited<ReturnType<typeof getCollection<"writing">>>;

  /** Current page number (1-indexed) */
  currentPage: number;

  /** Total number of pages */
  totalPages: number;

  /** Total count of all published articles */
  totalArticles: number;
}

const { articles, currentPage, totalPages, totalArticles } = Astro.props;

/**
 * Generates page title based on current page number
 *
 * Page 1 shows the main title, subsequent pages include page number.
 */
const pageTitle =
  currentPage === 1
    ? pagesConfig.writing.title
    : `${pagesConfig.writing.title} - Page ${currentPage}`;

const conciseTopics: Record<string, string[]> = {
  "offline-first-local-persistence-flutter-kidney-care": [
    "Flutter",
    "Offline-first",
    "SQLite",
  ],
  "monolith-or-microservices-choosing-the-right-architecture-for-scale": [
    "Architecture",
    "Microservices",
    "Scaling",
  ],
  "search-engine-stage-1": ["Python", "Search", "Inverted index"],
};
---

<BaseLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pagesConfig.writing.description}
    type="website"
  />

  <main class="page-container">
    <header class="page-header article-index__header">
      <h1 class="page-title">{pagesConfig.writing.heading}</h1>
      <p class="page-intro">
        {pagesConfig.writing.intro}
      </p>
      <p class="article-index__count">{String(totalArticles).padStart(2, "0")} articles</p>
    </header>

    {
      articles.length > 0 ? (
        <div class="article-index__list">
          {articles.map((article) => (
            <ArticleIndexItem
              title={article.data.title}
              slug={article.id}
              summary={article.data.description}
              publishDate={article.data.publishDate}
              topics={conciseTopics[article.id] ?? article.data.tags?.slice(0, 3)}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No articles published yet.</p>
      )
    }

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl="/blogs"
    />
  </main>
</BaseLayout>

<style>
  .page-container {
    max-width: 1120px;
  }

  .article-index__header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .article-index__header .page-title {
    margin-bottom: 0.65rem;
  }

  .article-index__header .page-intro {
    max-width: 43rem;
    margin-bottom: 0.85rem;
  }

  .article-index__count {
    margin: 0;
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-index__list {
    max-width: 68rem;
  }
</style>
