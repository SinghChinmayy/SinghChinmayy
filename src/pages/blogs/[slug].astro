---
/**
 * Article Detail Page
 *
 * Dynamic route that displays a full article with MDX content support, table of contents,
 * metadata, and structured data for SEO. Provides an optimized reading experience with
 * clean typography and responsive design.
 *
 * Features:
 * - MDX content rendering with full markdown support
 * - Automatic table of contents generation (when 3+ sections)
 * - Reading time calculation
 * - Article metadata (publish date, updated date, tags)
 * - Structured data for search engines
 * - Scroll-to-top functionality
 * - Back navigation to articles list
 * - Responsive typography
 *
 * Route: /blogs/[slug]
 *
 * @page
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SEO from "../../components/SEO.astro";
import StructuredData from "../../components/StructuredData.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import BackLink from "../../components/BackLink.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getReadingTime } from "../../utils/readingTime";
import { siteConfig } from "../../data";

/**
 * Generates static paths for all published articles
 *
 * Queries the writing collection and filters for published articles only
 * (draft: false), creating a route for each article using its ID as the slug.
 *
 * @returns Array of path objects with params
 */
export async function getStaticPaths() {
  const articles = await getCollection("writing", ({ data }) => {
    return data.draft === false;
  });
  return articles.map((article) => ({
    params: { slug: article.id },
  }));
}

const { slug } = Astro.params;

/**
 * Retrieves the specific article entry by slug
 *
 * Redirects to 404 if the article is not found.
 */
const article = await getEntry("writing", slug!);

if (!article) {
  return Astro.redirect("/404");
}

/**
 * Renders the article content and extracts headings
 *
 * The Content component renders the MDX, and headings are used for
 * the table of contents generation.
 */
const { Content, headings } = await render(article);

const { title, description, publishDate, updatedDate, tags } = article.data;

/**
 * Calculates reading time from the article body
 *
 * Uses word count to estimate reading time in minutes.
 */
const readingTime = getReadingTime(article.body || "");

/** Section label above the headline, taken from the first tag (e.g. "ai-assisted-development" → "ai assisted development") */
const kicker = tags?.[0]?.replace(/-/g, " ");

/**
 * Formats a date object for display
 *
 * Uses US English locale with full date format.
 * Example output: "January 15, 2024"
 *
 * @param date - The date to format
 * @returns Formatted date string
 */
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}
---
<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Blog`}
    description={description}
    type="article"
    publishDate={publishDate}
    updatedDate={updatedDate}
  />

  <StructuredData
    type="Article"
    data={{
      title,
      description,
      publishDate,
      updatedDate,
      tags,
      url: Astro.url.href,
    }}
  />

  <main class="article">
    <!-- Article Header: kicker, headline, deck, byline -->
    <header class="article-header">
      {kicker && <p class="article-kicker">{kicker}</p>}
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-byline">
        <span class="byline-author">By {siteConfig.author.name}</span>
        <div class="article-meta">
          <time class="publish-date" datetime={publishDate.toISOString()}>
            {formatDate(publishDate)}
          </time>
          <span class="meta-separator" aria-hidden="true">·</span>
          <span class="reading-time">{readingTime}</span>
          {
            updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
              <>
                <span class="meta-separator" aria-hidden="true">·</span>
                <time class="updated-date" datetime={updatedDate.toISOString()}>
                  Updated {formatDate(updatedDate)}
                </time>
              </>
            )
          }
        </div>
      </div>
      <ShareButtons
        title={title}
        description={description}
        url={Astro.url.href}
      />
    </header>

    <!-- Table of Contents (conditionally rendered if 3+ sections) -->
    <div class="article-column">
      <TableOfContents headings={headings} />
    </div>

    <!-- Article Content -->
    <article class="article-content">
      <Content />
    </article>

    <footer class="article-footer">
      {
        tags && tags.length > 0 && (
          <div class="article-topics">
            <span class="topics-label">Topics</span>
            <ul class="article-tags">
              {tags.map((tag) => (
                <li class="tag">{tag.replace(/-/g, " ")}</li>
              ))}
            </ul>
          </div>
        )
      }
      <ShareButtons
        title={title}
        description={description}
        url={Astro.url.href}
      />
      <BackLink href="/blogs" text="All blogs" />
    </footer>
  </main>

  <ScrollToTop />

  <style>
    .article {
      --figure-width: min(760px, calc(100vw - 2rem));
      padding: 3.5rem 1rem 4rem;
    }

    .article-column,
    .article-content,
    .article-footer {
      max-width: var(--max-width-article);
      margin-inline: auto;
    }

    /* Header */
    .article-header {
      max-width: 760px;
      margin: 0 auto 2.5rem;
      text-align: center;
    }

    .article-kicker {
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
      margin-bottom: 1rem;
    }

    .article-header h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.125rem, 5vw, 3.25rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.015em;
      margin-bottom: 1rem;
      text-wrap: balance;
    }

    .article-deck {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
      max-width: var(--max-width-article);
      margin: 0 auto 1.75rem;
      text-wrap: pretty;
    }

    .article-byline {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      font-family: var(--font-sans);
      font-size: 0.875rem;
      padding-block: 1rem;
      border-top: 1px solid var(--color-border);
      max-width: var(--max-width-article);
      margin: 0 auto 1rem;
    }

    .byline-author {
      font-weight: 700;
      color: var(--color-text);
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      color: var(--color-text-muted);
    }

    .article-header :global(.share-buttons),
    .article-header :global(.share) {
      justify-content: center;
    }

    /* Body */
    .article-content {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      line-height: 1.6;
      color: var(--color-text);
    }

    .article-content :global(h2) {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin: 3rem 0 1rem;
      scroll-margin-top: 5rem;
    }

    .article-content :global(h3) {
      font-family: var(--font-serif);
      font-size: 1.375rem;
      font-weight: 700;
      line-height: 1.3;
      margin: 2.25rem 0 0.75rem;
      scroll-margin-top: 5rem;
    }

    .article-content :global(h4) {
      font-family: var(--font-sans);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 2rem 0 0.5rem;
    }

    .article-content :global(p) {
      margin-bottom: 1.5rem;
      color: var(--color-text);
      line-height: 1.6;
    }

    /* Drop cap on the opening paragraph of the first section */
    .article-content > :global(h2:first-of-type + p::first-letter) {
      float: left;
      font-size: 4.25rem;
      line-height: 0.85;
      font-weight: 700;
      padding: 0.35rem 0.5rem 0 0;
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: var(--color-text);
    }

    .article-content :global(li) {
      margin-bottom: 0.6rem;
      line-height: 1.55;
    }

    .article-content :global(li::marker) {
      color: var(--color-text-muted);
    }

    .article-content :global(strong) {
      color: var(--color-text);
      font-weight: 700;
    }

    .article-content :global(a) {
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    .article-content :global(a:hover) {
      color: var(--color-accent);
    }

    /* Figures: images break out of the text column; an emphasised line in
       the same paragraph becomes the caption */
    .article-content :global(p:has(> img)) {
      width: var(--figure-width);
      margin: 2.5rem 0 2.5rem 50%;
      transform: translateX(-50%);
    }

    .article-content :global(img) {
      width: 100%;
      height: auto;
      margin: 0;
      border-radius: 0;
    }

    .article-content :global(p:has(> img) > em) {
      display: block;
      margin-top: 0.6rem;
      font-family: var(--font-sans);
      font-style: normal;
      font-size: 0.8125rem;
      line-height: 1.45;
      color: var(--color-text-muted);
    }

    .article-content :global(hr) {
      width: 4rem;
      margin: 3rem auto;
      border: none;
      border-top: 1px solid var(--color-text-muted);
    }

    /* Callouts: a tinted box with an ink rule, for interview excerpts and
       rule summaries. Nothing inside adds trailing space. */
    .article-content :global(blockquote) {
      margin: 2.25rem 0;
      padding: 1.25rem 1.5rem;
      border-left: 3px solid var(--color-rule);
      border-radius: 0 var(--border-radius-md) var(--border-radius-md) 0;
      background: var(--color-bg-elevated);
      font-size: 1.0625rem;
      line-height: 1.55;
      font-style: normal;
      color: var(--color-text);
    }

    .article-content :global(.callout-label) {
      display: block;
      font-family: var(--font-sans);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .article-content :global(blockquote > :first-child) {
      margin-top: 0;
    }

    .article-content :global(blockquote > :last-child),
    .article-content :global(blockquote li:last-child) {
      margin-bottom: 0;
    }

    .article-content :global(blockquote p) {
      margin-bottom: 0.9rem;
    }

    .article-content :global(blockquote ul) {
      margin-bottom: 0;
      padding-left: 1.25rem;
    }

    .article-content :global(blockquote li) {
      margin-bottom: 0.4rem;
    }

    .article-content :global(blockquote code) {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      font-size: 0.8em;
    }

    /* Tables: sans, hairline rules, scroll inside the column on phones */
    .article-content :global(table) {
      display: block;
      overflow-x: auto;
      width: 100%;
      margin: 2rem 0;
      border-collapse: collapse;
      font-family: var(--font-sans);
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .article-content :global(th) {
      text-align: left;
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text);
      padding: 0.6rem 0.75rem 0.6rem 0;
      border-bottom: 2px solid var(--color-rule);
    }

    .article-content :global(td) {
      vertical-align: top;
      color: var(--color-text-secondary);
      padding: 0.7rem 0.75rem 0.7rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .article-content :global(td code) {
      font-size: 0.85em;
    }

    /* Task list / checklist styles */
    .article-content :global(.contains-task-list) {
      list-style: none;
      padding-left: 0.25rem;
    }

    .article-content :global(.task-list-item) {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .article-content :global(.task-list-item input[type="checkbox"]) {
      appearance: none;
      -webkit-appearance: none;
      width: 1.15em;
      height: 1.15em;
      margin-top: 0.3em;
      border: 2px solid var(--color-text-muted, #666);
      border-radius: 3px;
      flex-shrink: 0;
      cursor: default;
      position: relative;
      background: transparent;
    }

    .article-content :global(.task-list-item input[type="checkbox"]:checked) {
      background: var(--color-accent, #4493f8);
      border-color: var(--color-accent, #4493f8);
    }

    .article-content
      :global(.task-list-item input[type="checkbox"]:checked::after) {
      content: "";
      position: absolute;
      left: 3px;
      top: 0px;
      width: 5px;
      height: 9px;
      border: solid #fff;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }

    /* GitHub-style callout/alert overrides */
    .article-content :global(.markdown-alert) {
      font-style: normal;
      padding: 1rem 1.25rem;
      margin: 2rem 0;
      border-radius: 0 8px 8px 0;
      background: var(--color-bg-secondary);
    }

    .article-content :global(.markdown-alert-title) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 0.9375rem;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .article-content :global(.markdown-alert p) {
      margin-bottom: 0.5rem;
      font-style: normal;
    }

    .article-content :global(.markdown-alert p:last-child) {
      margin-bottom: 0;
    }

    /* Note - blue */
    .article-content :global(.markdown-alert-note) {
      border-left: 4px solid #4493f8;
    }
    .article-content :global(.markdown-alert-note .markdown-alert-title) {
      color: #4493f8;
    }

    /* Tip - green */
    .article-content :global(.markdown-alert-tip) {
      border-left: 4px solid #3fb950;
    }
    .article-content :global(.markdown-alert-tip .markdown-alert-title) {
      color: #3fb950;
    }

    /* Important - purple */
    .article-content :global(.markdown-alert-important) {
      border-left: 4px solid #a371f7;
    }
    .article-content :global(.markdown-alert-important .markdown-alert-title) {
      color: #a371f7;
    }

    /* Warning - yellow/orange */
    .article-content :global(.markdown-alert-warning) {
      border-left: 4px solid #d29922;
    }
    .article-content :global(.markdown-alert-warning .markdown-alert-title) {
      color: #d29922;
    }

    /* Caution - red */
    .article-content :global(.markdown-alert-caution) {
      border-left: 4px solid #f85149;
    }
    .article-content :global(.markdown-alert-caution .markdown-alert-title) {
      color: #f85149;
    }

    .article-content :global(code) {
      font-family: var(--font-mono);
      font-size: 0.8em;
      background: var(--color-bg-elevated);
      padding: 0.15em 0.35em;
      border-radius: var(--border-radius-sm);
      color: var(--color-text);
    }

    .article-content :global(pre) {
      margin: 2rem 0;
      padding: 1.25rem;
      background: var(--color-bg-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius-md);
      overflow-x: auto;
    }

    .article-content :global(pre code) {
      background: none;
      padding: 0;
      font-size: 0.875rem;
      line-height: 1.6;
    }

    /* Footer: topics, share, back link */
    .article-footer {
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      border-top: 2px solid var(--color-rule);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .article-topics {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.75rem;
      font-family: var(--font-sans);
    }

    .topics-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
    }

    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .tag {
      margin: 0;
      font-size: 0.8125rem;
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      color: var(--color-text-secondary);
      text-transform: capitalize;
    }

    @media (max-width: 768px) {
      .article {
        padding: 2rem 1rem 3rem;
      }

      .article-deck {
        font-size: 1.125rem;
      }

      .article-content {
        font-size: 1.125rem;
      }

      .article-content :global(h2) {
        font-size: 1.5rem;
      }

      .article-content :global(h3) {
        font-size: 1.25rem;
      }

      .article-content :global(p:has(> img)) {
        margin-block: 2rem;
      }

      .article-content :global(pre) {
        padding: 0.875rem;
      }

      .article-content :global(.markdown-alert) {
        padding: 1rem;
        margin-inline: 0;
      }
    }
  </style>
</BaseLayout>
