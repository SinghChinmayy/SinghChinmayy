---
/**
 * Article Detail Page
 *
 * Dynamic route that displays a full article with MDX content support, table of contents,
 * metadata, and structured data for SEO. Provides an optimized reading experience with
 * clean typography and responsive design.
 *
 * Features:
 * - MDX content rendering with full markdown support
 * - Automatic table of contents generation (when 3+ sections)
 * - Reading time calculation
 * - Article metadata (publish date, updated date, tags)
 * - Structured data for search engines
 * - Scroll-to-top functionality
 * - Back navigation to articles list
 * - Responsive typography
 *
 * Route: /blogs/[slug]
 *
 * @page
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SEO from "../../components/SEO.astro";
import StructuredData from "../../components/StructuredData.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ScrollToTop from "../../components/ScrollToTop.astro";
import BackLink from "../../components/BackLink.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getReadingTime } from "../../utils/readingTime";
import "../../styles/article.css";
import { siteConfig } from "../../data";

/**
 * Generates static paths for all published articles
 *
 * Queries the writing collection and filters for published articles only
 * (draft: false), creating a route for each article using its ID as the slug.
 *
 * @returns Array of path objects with params
 */
export async function getStaticPaths() {
  const articles = await getCollection("writing", ({ data }) => {
    return data.draft === false;
  });
  return articles.map((article) => ({
    params: { slug: article.id },
  }));
}

const { slug } = Astro.params;

/**
 * Retrieves the specific article entry by slug
 *
 * Redirects to 404 if the article is not found.
 */
const article = await getEntry("writing", slug!);

if (!article) {
  return Astro.redirect("/404");
}

/**
 * Renders the article content and extracts headings
 *
 * The Content component renders the MDX, and headings are used for
 * the table of contents generation.
 */
const { Content, headings } = await render(article);

const { title, description, publishDate, updatedDate, tags } = article.data;

/**
 * Calculates reading time from the article body
 *
 * Uses word count to estimate reading time in minutes.
 */
const readingTime = getReadingTime(article.body || "");

/** Section label above the headline, taken from the first tag (e.g. "ai-assisted-development" → "ai assisted development") */
const kicker = tags?.[0]?.replace(/-/g, " ");

/**
 * Formats a date object for display
 *
 * Uses US English locale with full date format.
 * Example output: "January 15, 2024"
 *
 * @param date - The date to format
 * @returns Formatted date string
 */
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}
---
<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Blog`}
    description={description}
    type="article"
    publishDate={publishDate}
    updatedDate={updatedDate}
  />

  <StructuredData
    type="Article"
    data={{
      title,
      description,
      publishDate,
      updatedDate,
      tags,
      url: Astro.url.href,
    }}
  />

  <main class="article">
    <!-- Article Header: kicker, headline, deck, byline -->
    <header class="article-header">
      {kicker && <p class="article-kicker">{kicker}</p>}
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-byline">
        <span class="byline-author">By {siteConfig.author.name}</span>
        <div class="article-meta">
          <time class="publish-date" datetime={publishDate.toISOString()}>
            {formatDate(publishDate)}
          </time>
          <span class="meta-separator" aria-hidden="true">·</span>
          <span class="reading-time">{readingTime}</span>
          {
            updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
              <>
                <span class="meta-separator" aria-hidden="true">·</span>
                <time class="updated-date" datetime={updatedDate.toISOString()}>
                  Updated {formatDate(updatedDate)}
                </time>
              </>
            )
          }
        </div>
      </div>
      <ShareButtons
        title={title}
        description={description}
        url={Astro.url.href}
      />
    </header>

    <!-- Table of Contents (conditionally rendered if 3+ sections) -->
    <div class="article-column">
      <TableOfContents headings={headings} />
    </div>

    <!-- Article Content -->
    <article class="article-content">
      <Content />
    </article>

    <footer class="article-footer">
      {
        tags && tags.length > 0 && (
          <div class="article-topics">
            <span class="topics-label">Topics</span>
            <ul class="article-tags">
              {tags.map((tag) => (
                <li class="tag">{tag.replace(/-/g, " ")}</li>
              ))}
            </ul>
          </div>
        )
      }
      <ShareButtons
        title={title}
        description={description}
        url={Astro.url.href}
      />
      <BackLink href="/blogs" text="All blogs" />
    </footer>
  </main>

  <ScrollToTop />

</BaseLayout>
