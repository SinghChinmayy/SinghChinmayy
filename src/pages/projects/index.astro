---
/**
 * Projects Index Page
 * 
 * Lists all projects as case studies with impact summaries. Projects are displayed
 * in a prioritized order: custom order (if specified) takes precedence, otherwise
 * sorted by year (most recent first). Featured projects are highlighted.
 * 
 * Features:
 * - Queries all projects from content collection
 * - Smart sorting: custom order → year (descending)
 * - Displays a compact editorial index of case studies
 * - SEO optimization
 * - Empty state handling
 * 
 * Route: /projects
 * 
 * @page
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import ProjectIndexItem from '../../components/ProjectIndexItem.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';

/**
 * Queries all projects from the content collection
 */
const allProjects = await getCollection('projects');

/**
 * Sorts projects with intelligent prioritization
 * 
 * Sorting logic:
 * 1. If both projects have an 'order' field, sort by order (ascending)
 * 2. Projects with 'order' field are prioritized over those without
 * 3. Projects without 'order' are sorted by year (descending - newest first)
 * 
 * This allows manual curation of featured projects while maintaining
 * chronological order for others.
 */
const sortedProjects = allProjects.sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;

  if (orderA !== orderB) return orderA - orderB;
  return b.data.year - a.data.year;
});

/**
 * Total count of projects for statistics display
 */
const totalProjects = sortedProjects.length;

const conciseSummaries: Record<string, string> = {
  'aegis-observability-remediation':
    'A Go backend for controlled remediation: detect failures, require approval, and verify recovery with operational evidence.',
  'kidney-care':
    'An offline-first Flutter prototype that keeps vitals local, then reconciles changes with Supabase through a registry-driven sync engine.',
  'nlp-search-engine':
    'A modular Python search pipeline that turns text into an inverted index, with ranking and semantic search left as deliberate next steps.',
};
---

<BaseLayout>
  <SEO 
    slot="head"
    title={pagesConfig.projects.title}
    description={pagesConfig.projects.description}
    type="website"
  />

  <main class="page-container section-front">
    <header class="page-header section-front__header">
      <h1 class="page-title">{pagesConfig.projects.heading}</h1>
      <p class="page-intro">
        {pagesConfig.projects.intro}
      </p>
    </header>

    <section aria-labelledby="project-index-label">
      <h2 class="section-label" id="project-index-label">
        <span>Case studies</span>
        <span class="section-label__count">{String(totalProjects).padStart(2, '0')} selected projects</span>
      </h2>

      {sortedProjects.length > 0 ? (
        <div class="section-front__list">
          {sortedProjects.map((project, index) => (
            <ProjectIndexItem
              number={String(index + 1).padStart(2, '0')}
              title={project.data.title}
              slug={project.id}
              summary={conciseSummaries[project.id] ?? project.data.outcomeSummary}
              year={project.data.year}
              techStack={project.data.techStack}
              status={project.data.status}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No projects available yet.</p>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .section-front__header {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }

  .section-front__header .page-intro {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .section-front__header {
      margin-bottom: 3rem;
    }
  }
</style>
