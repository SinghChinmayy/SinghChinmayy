---
/**
 * Case Study Detail Page
 * 
 * Dynamic route that displays a comprehensive project case study following a structured
 * narrative format. Presents the complete story of a project from problem identification
 * through to measurable impact and learnings.
 * 
 * Narrative Structure (enforced order):
 * 1. Overview - High-level project summary
 * 2. Problem - Challenge being addressed
 * 3. Constraints - Limitations and boundaries
 * 4. Approach - Solution strategy
 * 5. Key Decisions - Technical choices with reasoning and alternatives
 * 6. Tech Stack - Technologies used
 * 7. Result & Impact - Quantitative metrics and qualitative outcomes
 * 8. Learnings - Insights and takeaways
 * 
 * Features:
 * - Static path generation for all project entries
 * - Structured case study presentation
 * - Impact metrics data box (when available)
 * - Reading time calculation
 * - Structured data for SEO
 * - Optional additional markdown content
 * - Scroll-to-top functionality
 * - Related content navigation
 * - Back navigation to projects list
 * 
 * Route: /projects/[slug]
 * 
 * @page
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';
import { siteConfig } from '../../data/index';

/**
 * Generates static paths for all project entries
 * 
 * Queries the projects content collection and creates a route for each entry
 * using the entry ID as the slug parameter.
 * 
 * @returns Array of path objects with params
 */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;

/**
 * Retrieves the specific project entry by slug
 * 
 * Redirects to 404 if the project is not found.
 */
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

// Render the content (v6-compatible method)
const { Content } = await render(project);

const {
  title,
  role,
  year,
  duration,
  teamSize,
  outcomeSummary,
  overview,
  problem,
  constraints,
  approach,
  keyDecisions,
  techStack,
  impact,
  learnings,
  relatedProjects,
  status,
} = project.data;

// Status display configuration
const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
};
const statusInfo = statusConfig[status || 'completed'];

/**
 * Calculates reading time from all case study content
 * 
 * Combines all text sections including overview, problem, approach, decisions,
 * impact, learnings, and optional markdown body to estimate total reading time.
 */
const allText = [
  overview,
  problem,
  approach,
  ...constraints,
  ...keyDecisions.map(d => `${d.decision} ${d.reasoning} ${d.alternatives?.join(' ') || ''}`),
  impact.qualitative,
  ...learnings,
  project.body || '',
].join(' ');
const readingTime = formatReadingTime(calculateReadingTime(allText));
---

<BaseLayout>
  <SEO 
    slot="head"
    title={`${title} - Case Study`}
    description={outcomeSummary}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{
      title,
      outcomeSummary,
      problem,
      impact: impact.qualitative,
      techStack,
      year,
    }}
  />

  <main class="case-study">
    <!-- Case Study Header: centered, like the article page -->
    <header class="case-study-header">
      <p class="case-study-kicker">
        <span>{role}</span>
        <span class="kicker-separator" aria-hidden="true">·</span>
        <span>{year}</span>
        <span class="kicker-separator" aria-hidden="true">·</span>
        <span class:list={['status-label', statusInfo.class]}>{statusInfo.label}</span>
      </p>
      <h1>{title}</h1>
      <p class="outcome-summary">{outcomeSummary}</p>
      <div class="case-study-meta">
        <span class="meta-item meta-author">By {siteConfig.author.name}</span>
        {duration && (
          <span class="meta-item">{duration}</span>
        )}
        {teamSize && (
          <span class="meta-item">{teamSize} {teamSize === 1 ? 'person' : 'people'}</span>
        )}
        <span class="meta-item">{readingTime}</span>
      </div>
    </header>

    <div class="case-study-body">
      <!-- Overview Section -->
      <section class="case-study-section">
        <h2>Overview</h2>
        <p>{overview}</p>
      </section>

      <!-- Problem Section -->
      <section class="case-study-section">
        <h2>Problem</h2>
        <p>{problem}</p>
      </section>

      <!-- Constraints Section -->
      <section class="case-study-section">
        <h2>Constraints</h2>
        <ul class="ruled-list constraints-list">
          {constraints.map((constraint) => (
            <li>{constraint}</li>
          ))}
        </ul>
      </section>

      <!-- Approach Section -->
      <section class="case-study-section">
        <h2>Approach</h2>
        <p>{approach}</p>
      </section>

      <!-- Key Decisions Section -->
      <section class="case-study-section">
        <h2>Key Decisions</h2>
        <ol class="decisions-list">
          {keyDecisions.map((decision, index) => (
            <li class="decision-item">
              <p class="decision-kicker">Decision {String(index + 1).padStart(2, '0')}</p>
              <h3 class="decision-title">{decision.decision}</h3>
              <div class="decision-reasoning">
                <strong>Reasoning</strong>
                <p>{decision.reasoning}</p>
              </div>
              {decision.alternatives && decision.alternatives.length > 0 && (
                <div class="decision-alternatives">
                  <strong>Alternatives considered</strong>
                  <ul>
                    {decision.alternatives.map((alt) => (
                      <li>{alt}</li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>

      <!-- Tech Stack Section -->
      <section class="case-study-section">
        <h2>Tech Stack</h2>
        <ul class="tech-stack-list">
          {techStack.map((tech) => (
            <li class="tag">{tech}</li>
          ))}
        </ul>
      </section>

      <!-- Result/Impact Section -->
      <section class="case-study-section">
        <h2>Result &amp; Impact</h2>

        {/* Display metrics as a newspaper-style data box */}
        {impact.metrics && impact.metrics.length > 0 && (
          <ImpactMetrics metrics={impact.metrics} />
        )}

        <p class="impact-qualitative">{impact.qualitative}</p>
      </section>

      <!-- Learnings Section -->
      <section class="case-study-section">
        <h2>Learnings</h2>
        <ol class="ruled-list learnings-list">
          {learnings.map((learning) => (
            <li>{learning}</li>
          ))}
        </ol>
      </section>

      <!-- Additional MDX Content (if any) -->
      {Content && (
        <section class="case-study-content prose">
          <Content />
        </section>
      )}

      <!-- Related Content -->
      <RelatedContent 
        relatedProjects={relatedProjects} 
      />

      <BackLink href="/projects" text="All projects" />
    </div>
  </main>

  <ScrollToTop />

  <style>
    .case-study {
      --case-study-column: 680px;
      max-width: calc(var(--case-study-column) + 2rem);
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
    }

    /* ---------- Header ---------- */

    .case-study-header {
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--color-border);
      text-align: center;
    }

    .case-study-kicker {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 0.5rem;
      margin: 0 0 1rem;
      font-family: var(--font-sans);
      font-size: var(--font-size-xs);
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
    }

    .kicker-separator {
      color: var(--color-text-muted);
    }

    .status-label {
      color: var(--color-text-muted);
    }

    .case-study-header h1 {
      margin: 0 0 1rem;
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 9vw, 2.75rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      overflow-wrap: break-word;
    }

    .outcome-summary {
      margin: 0 auto 1.5rem;
      max-width: 36rem;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.45;
      color: var(--color-text-secondary);
    }

    .case-study-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 0;
      font-family: var(--font-sans);
      font-size: var(--font-size-sm);
      line-height: 1.5;
      color: var(--color-text-muted);
    }

    .meta-item + .meta-item::before {
      content: '·';
      margin: 0 0.5rem;
      color: var(--color-text-muted);
      font-weight: 400;
    }

    .meta-author {
      font-weight: 700;
      color: var(--color-text);
    }

    /* ---------- Body column ---------- */

    .case-study-body {
      max-width: var(--case-study-column);
      margin: 0 auto;
    }

    .case-study-section {
      margin-bottom: 2.75rem;
    }

    .case-study-section h2 {
      margin: 0 0 1rem;
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .case-study-section p,
    .impact-qualitative {
      margin: 0;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
    }

    /* Editorial lists: hairline rules between items, no arrows or bullets */
    .ruled-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-border);
    }

    .ruled-list > li {
      margin: 0;
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--color-text-secondary);
    }

    /* Learnings carry a small sans index number */
    .learnings-list {
      counter-reset: learning;
    }

    .learnings-list > li {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.5rem;
      counter-increment: learning;
    }

    .learnings-list > li::before {
      content: counter(learning, decimal-leading-zero);
      padding-top: 0.2rem;
      font-family: var(--font-sans);
      font-size: var(--font-size-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--color-text);
    }

    /* Key decisions: each one under a rule, like a numbered sidebar */
    .decisions-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .decision-item {
      margin: 0;
      padding: 1.25rem 0 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .decision-item:first-child {
      border-top: 2px solid var(--color-rule);
    }

    .decision-item:last-child {
      border-bottom: 1px solid var(--color-border);
    }

    .case-study-section .decision-kicker {
      margin: 0 0 0.375rem;
      font-family: var(--font-sans);
      font-size: var(--font-size-xs);
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .decision-title {
      margin: 0 0 0.875rem;
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.25;
      color: var(--color-text);
    }

    .decision-alternatives {
      margin-top: 1rem;
    }

    .decision-reasoning strong,
    .decision-alternatives strong {
      display: block;
      margin-bottom: 0.25rem;
      font-family: var(--font-sans);
      font-size: var(--font-size-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
    }

    .case-study-section .decision-reasoning p {
      font-size: 1.0625rem;
      line-height: 1.6;
    }

    .decision-alternatives ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .decision-alternatives li {
      position: relative;
      margin: 0;
      padding: 0.125rem 0 0.125rem 1.25rem;
      font-family: var(--font-serif);
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--color-text-secondary);
    }

    .decision-alternatives li::before {
      content: '–';
      position: absolute;
      left: 0;
      color: var(--color-text-muted);
    }

    /* Tech stack: small sans uppercase chips (uses the shared .tag utility) */
    .tech-stack-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .tech-stack-list li {
      margin: 0;
    }

    /* ---------- Additional MDX content ---------- */

    .case-study-content {
      max-width: none;
      margin-top: 3rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-border);
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
      overflow-wrap: break-word;
    }

    .case-study-content :global(p),
    .case-study-content :global(li) {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      line-height: 1.65;
    }

    .case-study-content :global(h2) {
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .case-study-content :global(h3) {
      margin-top: 2rem;
      font-size: 1.25rem;
    }

    .case-study-content :global(a) {
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-underline-offset: 3px;
    }

    .case-study-content :global(a:hover) {
      color: var(--color-accent);
    }

    .case-study-content :global(ul),
    .case-study-content :global(ol) {
      padding-left: 1.25rem;
    }

    .case-study-content :global(pre) {
      max-width: 100%;
      margin: 1.5rem 0;
      padding: 1rem;
      overflow-x: auto;
      border: 1px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    @media (min-width: 768px) {
      .case-study {
        padding: 3.5rem 1.5rem 5rem;
        max-width: calc(var(--case-study-column) + 3rem);
      }

      .case-study-header {
        margin-bottom: 3rem;
        padding-bottom: 1.75rem;
      }

      .case-study-header h1 {
        font-size: clamp(2.75rem, 5vw, 3.25rem);
      }

      .outcome-summary {
        font-size: 1.25rem;
      }

      .case-study-section {
        margin-bottom: 3.25rem;
      }

      .case-study-section h2,
      .case-study-content :global(h2) {
        font-size: 1.75rem;
      }

      .case-study-section p,
      .impact-qualitative,
      .case-study-content :global(p),
      .case-study-content :global(li) {
        font-size: 1.1875rem;
      }

      .decision-title {
        font-size: 1.375rem;
      }
    }
  </style>
</BaseLayout>
