---
/**
 * Contact Page
 *
 * Minimal, intentional contact page with clear visual hierarchy and zone-based layout.
 * Prioritizes email as the primary contact method while providing secondary social links.
 *
 * Layout Structure:
 * - Zone 1 (Primary): Editorial header (kicker, serif headline, deck) and the
 *   email address set large in serif under a section label
 * - Zone 2 (Secondary): Social media links as a ruled list (only shown if configured)
 *
 * Features:
 * - Clean, distraction-free design
 * - Large, prominent email link
 * - Automatic filtering of configured social links
 * - Responsive layout
 * - Clear visual hierarchy
 *
 * Route: /contact
 *
 * @page
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import SEO from "../components/SEO.astro";
import { siteConfig } from "../data/index";

/**
 * Filters and formats social links from site configuration
 *
 * Only includes platforms that have a URL configured (non-empty values).
 * Capitalizes platform names for display (e.g., "github" becomes "Github").
 *
 * @returns Array of social link objects with platform name and URL
 */
const socialLinks = siteConfig.social
  .filter((link) => !!link.url)
  .map((link) => ({
    label:
      link.label ||
      link.platform.charAt(0).toUpperCase() + link.platform.slice(1),
    url: link.url,
  }));
---

<BaseLayout>
  <SEO
    slot="head"
    title={siteConfig.contactPage.title}
    description={siteConfig.contactPage.description}
    type="website"
  />

  <main class="page-container contact-page">
    <!-- Zone 1: Primary Intent -->
    <section class="primary-zone">
      <header class="page-header contact-header">
        <p class="kicker contact-kicker">Contact</p>
        <h1 class="page-title">{siteConfig.contactPage.heading}</h1>
        <p class="page-intro context">
          I read every email. Expect a reply within a few days.
        </p>
      </header>

      <h2 class="section-label">Email</h2>
      <a href={`mailto:${siteConfig.author.email}`} class="email-link">
        {siteConfig.author.email}
      </a>
    </section>

    <!-- Zone 2: Secondary (Social) -->
    {
      socialLinks.length > 0 && (
        <section class="secondary-zone" aria-labelledby="contact-elsewhere">
          <h2 class="section-label" id="contact-elsewhere">Elsewhere</h2>
          <ul class="social-links">
            {socialLinks.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  <span>{link.label}</span>
                  <span class="external-mark" aria-hidden="true">↗</span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <style>
    .contact-page {
      max-width: calc(var(--max-width-article) + 2rem);
    }

    .contact-header {
      margin-bottom: 2.5rem;
    }

    .contact-kicker {
      margin: 0 0 0.75rem;
    }

    .primary-zone {
      margin-bottom: 3rem;
    }

    .email-link {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.25rem 0;
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 7.5vw, 2.25rem);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.015em;
      color: var(--color-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: var(--color-border);
      text-underline-offset: 6px;
      overflow-wrap: anywhere;
    }

    .email-link:hover {
      color: var(--color-text);
      text-decoration-color: var(--color-text);
    }

    .social-links {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .social-links li {
      margin: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .social-links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3rem;
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      text-decoration: none;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }

    .social-links a:hover {
      color: var(--color-text);
    }

    .social-links a:hover span:first-child {
      text-decoration: underline;
    }

    .external-mark {
      color: var(--color-text-muted);
      font-weight: 400;
    }
  </style>
</BaseLayout>
