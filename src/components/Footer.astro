---
/**
 * Footer Component
 *
 * Site-wide footer displaying copyright information and social media links.
 * Automatically filters and displays only configured social links from site config.
 * Responsive layout that stacks vertically on mobile devices.
 *
 * Social links are pulled from siteConfig.social and only displayed if they have
 * a URL value configured. Links open in new tabs with proper security attributes.
 *
 * @component
 *
 * @example
 * ```astro
 * <Footer />
 * ```
 */
import { siteConfig } from "../data/index";
import ThemeToggle from "./ThemeToggle.astro";

/**
 * Gets the current year for copyright display
 */
const currentYear = new Date().getFullYear();

/**
 * Filters and formats social links from site configuration
 *
 * Only includes platforms that have a URL configured (non-empty values).
 * Capitalizes platform names for display (e.g., "github" becomes "Github").
 *
 * @returns Array of social link objects with platform name and URL
 */
const socialLinks = siteConfig.social
  .filter((link) => !!link.url)
  .map((link) => ({
    label:
      link.label ||
      link.platform.charAt(0).toUpperCase() + link.platform.slice(1),
    url: link.url,
  }));
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <a class="footer-wordmark" href="/">{siteConfig.author.name}</a>
      <div class="theme-toggle-wrapper">
        <ThemeToggle />
      </div>
    </div>

    <div class="footer-bottom">
      <nav class="footer-links" aria-label="Site resources">
        <a href="/rss.xml" class="essential-link">RSS</a>
        <span class="separator" aria-hidden="true">·</span>
        <a href="/sitemap-index.xml" class="essential-link">Sitemap</a>
        <span class="separator" aria-hidden="true">·</span>
        <a
          href="https://github.com/SinghChinmayy/SinghChinmayy"
          target="_blank"
          rel="noopener noreferrer"
          class="essential-link">Source</a
        >
      </nav>

      {
        socialLinks.length > 0 && (
          <div class="footer-social">
            {socialLinks.map((link, index) => (
              <>
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
                {index < socialLinks.length - 1 && (
                  <span class="separator" aria-hidden="true">·</span>
                )}
              </>
            ))}
          </div>
        )
      }

      <p class="copyright">© {currentYear} {siteConfig.author.name}</p>
    </div>
  </div>
</footer>

<style>
  /* Newspaper colophon: heavy ink rule, serif wordmark, small sans text. */
  .site-footer {
    margin-top: auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem) 2.5rem;
    background: var(--color-bg);
  }

  .footer-container {
    max-width: var(--max-width-content);
    margin: 0 auto;
    border-top: 2px solid var(--color-rule);
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .footer-wordmark:hover {
    color: var(--color-text);
  }

  .theme-toggle-wrapper {
    display: flex;
    align-items: center;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .footer-links,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.625rem;
  }

  .essential-link,
  .footer-social a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .essential-link {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .essential-link:hover,
  .footer-social a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .separator {
    color: var(--color-text-muted);
    user-select: none;
  }

  .copyright {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .footer-bottom {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-social {
      justify-content: center;
    }

    .copyright {
      margin: 0;
    }
  }
</style>
