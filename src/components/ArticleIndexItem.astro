---
/**
 * ArticleIndexItem Component
 *
 * One entry in the /blogs section front: kicker (topics), serif headline,
 * serif deck, and muted sans metadata (date · reading time). Items are
 * separated by hairline rules; on wider screens the date moves into a left rail.
 */
interface Props {
  title: string;
  slug: string;
  summary: string;
  publishDate: Date;
  topics?: string[];
  /** Pre-formatted reading time, e.g. "6 min read" */
  readingTime?: string;
}

const { title, slug, summary, publishDate, topics = [], readingTime } = Astro.props;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}

const dateLabel = formatDate(publishDate);
---

<article class="article-index__item">
  <time class="article-index__date" datetime={publishDate.toISOString()}>
    {dateLabel}
  </time>

  <div class="article-index__body">
    {topics.length > 0 && (
      <p class="article-index__kicker">
        <span class="visually-hidden">Topics: </span>
        {topics.join(' · ')}
      </p>
    )}
    <h3 class="article-index__title">
      <a href={`/blogs/${slug}`}>{title}</a>
    </h3>
    <p class="article-index__summary">{summary}</p>
    <p class="article-index__meta">
      <time class="article-index__meta-date" datetime={publishDate.toISOString()}>{dateLabel}</time>
      {readingTime && (
        <span class="article-index__reading">{readingTime}</span>
      )}
    </p>
  </div>
</article>

<style>
  .article-index__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Rail date only appears on wider screens; phones read the date in the meta row */
  .article-index__date {
    display: none;
  }

  .article-index__body {
    min-width: 0;
    max-width: 46rem;
  }

  .article-index__kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .article-index__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .article-index__title a {
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .article-index__title a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .article-index__summary {
    display: -webkit-box;
    margin: 0 0 0.75rem;
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .article-index__meta {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .article-index__reading::before {
    content: '·';
    margin: 0 0.5rem;
  }

  @media (min-width: 768px) {
    .article-index__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      padding: 1.75rem 0;
    }

    .article-index__date {
      display: block;
      padding-top: 0.1rem;
      font-family: var(--font-sans);
      font-size: var(--font-size-xs);
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
      white-space: nowrap;
    }

    .article-index__meta-date {
      display: none;
    }

    .article-index__reading::before {
      content: none;
    }

    .article-index__summary {
      font-size: 1.125rem;
    }
  }
</style>
