---
/**
 * BaseCard Component
 * 
 * Foundation component providing consistent styling and structure for all card types.
 * This component should not be used directly - instead use specialized cards like
 * ArticleCard, ProjectCard, or DecisionCard for specific content types.
 * 
 * Editorial list item rather than a boxed card: no fill, shadow or rounded box.
 * Items sit on the page between hairline rules (top on every item, bottom on the
 * last one), with a sans kicker, serif headline and deck, and sans metadata.
 *
 * Features:
 * - Headline underlines on hover
 * - Responsive padding and typography
 * - Flexible slot-based content structure
 * - Accessible link wrapper
 * 
 * @component
 * 
 * @slot badge - Optional badge/label at top (e.g., "Featured")
 * @slot meta - Metadata line (date, role, category, etc.)
 * @slot title - Card heading/title
 * @slot description - Card description or summary text
 * @slot tags - Container for tag list
 * @slot default - CTA links or additional content at bottom
 * 
 * @example
 * ```astro
 * <BaseCard href="/example" class="custom-card">
 *   <Fragment slot="meta">January 2024</Fragment>
 *   <Fragment slot="title">Card Title</Fragment>
 *   <Fragment slot="description">Card description text</Fragment>
 *   <ForwardLink text="Read more" />
 * </BaseCard>
 * ```
 */

interface Props {
  /** Target URL for the card link (required) */
  href: string;
  
  /** Additional CSS classes to apply to the card */
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={['base-card', className]}>
  <slot name="badge" />
  <span class="card-meta"><slot name="meta" /></span>
  <span class="card-title"><slot name="title" /></span>
  <span class="card-description"><slot name="description" /></span>
  <slot name="tags" />
  <slot />
</a>

<style>
  .base-card {
    display: block;
    position: relative;
    padding: 1.25rem 0 1.375rem;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .base-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .base-card:hover {
    color: var(--color-text);
  }

  .base-card:hover .card-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Kicker / dateline above the headline. */
  .card-meta {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .card-title {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  /* Deck: short serif summary under the headline. */
  .card-description {
    display: block;
    max-width: var(--max-width-prose);
    margin-bottom: 0.875rem;
    color: var(--color-text-secondary);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .card-title {
      font-size: 1.25rem;
    }

    .card-description {
      font-size: 1rem;
    }
  }
</style>
