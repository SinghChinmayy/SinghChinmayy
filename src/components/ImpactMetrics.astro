---
/**
 * ImpactMetrics Component
 * 
 * Displays project impact metrics as a newspaper-style data box: a sans label,
 * a large serif figure (when the value starts with a number), and the rest of
 * the value in serif. Cells are separated by hairline rules under a heavy ink rule.
 * 
 * Features:
 * - One column on phones, two columns from 640px
 * - Flexible for varying content lengths (values are never truncated)
 * - Rules instead of boxes, no backgrounds or shadows
 * 
 * @component
 * 
 * @example
 * ```astro
 * <ImpactMetrics metrics={[
 *   { label: "Processing Time", value: "60% reduction (from 2.5s to 1s)" },
 *   { label: "Uptime", value: "99.9% (up from 97.2%)" },
 *   { label: "Security Incidents", value: "Zero auth-related breaches" }
 * ]} />
 * ```
 */

interface Metric {
  /** Metric category or name (displayed above the value) */
  label: string;
  
  /** Metric value or result (displayed prominently) */
  value: string;
}

interface Props {
  /** Array of metrics to display */
  metrics: Metric[];
}

const { metrics } = Astro.props;

/**
 * Splits a value into a leading figure and the remaining text so the figure can
 * be set large, like a newspaper data box. The full value is preserved:
 * "160 backend tests" -> { figure: "160", rest: "backend tests" }.
 * Values without a leading number are left whole.
 */
function splitFigure(value: string): { figure: string; rest: string } {
  const match = value.match(/^(\d[\d,.]*\+?%?)(?:\s+(.+))?$/s);
  if (!match) return { figure: '', rest: value };
  return { figure: match[1], rest: match[2] ?? '' };
}

const items = metrics.map((metric) => ({ ...metric, ...splitFigure(metric.value) }));
---

<ul class="impact-metrics">
  {items.map((metric) => (
    <li class="metric-item">
      <span class="metric-label">{metric.label}</span>
      <span class="metric-value">
        {metric.figure && <span class="metric-figure">{metric.figure}</span>}
        {metric.figure && metric.rest && ' '}
        {metric.rest && <span class="metric-text">{metric.rest}</span>}
      </span>
    </li>
  ))}
</ul>

<style>
  /* Newspaper data box: heavy ink rule on top, hairlines between cells */
  .impact-metrics {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 2px solid var(--color-rule);
    border-bottom: 1px solid var(--color-border);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
    padding: 1rem 0 1.125rem;
  }

  .metric-item + .metric-item {
    border-top: 1px solid var(--color-border);
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .metric-value {
    font-family: var(--font-serif);
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  .metric-figure {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .metric-text {
    display: block;
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  /* Value with no leading figure reads as a short serif statement */
  .metric-value > .metric-text:only-child {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }

  .metric-figure + .metric-text {
    margin-top: 0.375rem;
  }

  @media (min-width: 640px) {
    .impact-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric-item:nth-child(odd) {
      padding-right: 1.5rem;
      border-right: 1px solid var(--color-border);
    }

    .metric-item:nth-child(even) {
      padding-left: 1.5rem;
    }

    /* Hairlines only between rows in the two-column layout */
    .metric-item + .metric-item {
      border-top: 0;
    }

    .metric-item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }

    /* A lone last item spans both columns */
    .metric-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
