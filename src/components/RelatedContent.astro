---
/**
 * RelatedContent Component
 *
 * Displays related projects for cross-referencing content.
 * Fetches actual content data from slugs and renders an editorial list:
 * a section label over an ink rule, then kicker + serif headline per item.
 *
 * @component
 *
 * @example
 * ```astro
 * <RelatedContent
 *   relatedProjects={['project-slug-1', 'project-slug-2']}
 * />
 * ```
 */

import { getCollection } from "astro:content";

interface Props {
  /** Array of project slugs to display */
  relatedProjects?: string[];

  /** Section title (default: "Related") */
  title?: string;
}

const {
  relatedProjects = [],
  title = "Related",
} = Astro.props;

const allProjects = await getCollection("projects").catch(() => []);

const projects = relatedProjects
  .map((slug: string) => allProjects.find((p: any) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const hasRelated = projects.length > 0;
---

{
  hasRelated && (
    <aside class="related-content" aria-labelledby="related-content-title">
      <div class="related-header">
        <h2 class="related-title" id="related-content-title">{title}</h2>
        <span class="related-section-title">Case studies</span>
      </div>

      <ul class="related-list">
        {projects.map((project: any) => (
          <li>
            <a href={`/projects/${project.id}`} class="related-item">
              <span class="related-item-meta">
                {project.data.role} · {project.data.year}
              </span>
              <span class="related-item-title">{project.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-content {
    margin-top: 3.5rem;
  }

  /* Section label over a heavy ink rule */
  .related-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-rule);
  }

  .related-title,
  .related-section-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .related-section-title {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .related-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-list li {
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .related-item {
    display: block;
    padding: 1rem 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .related-item-meta {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .related-item-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .related-item:hover .related-item-title {
    text-decoration: underline;
  }
</style>
