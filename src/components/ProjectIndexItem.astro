---
/**
 * ProjectIndexItem Component
 *
 * One entry in the /projects section front: kicker (year and status), serif
 * headline, serif deck, and muted sans metadata (tech stack). Items are
 * separated by hairline rules; on wider screens the kicker moves into a left rail.
 */
interface Props {
  /** Position in the list (accepted for compatibility; not displayed) */
  number?: string;
  title: string;
  slug: string;
  summary: string;
  year: number;
  status?: 'completed' | 'ongoing' | 'archived';
  techStack?: string[];
}

const {
  title,
  slug,
  summary,
  year,
  status = 'completed',
  techStack = [],
} = Astro.props;

const statusLabel = {
  completed: 'Completed',
  ongoing: 'In progress',
  archived: 'Archived',
}[status];
---

<article class="project-index__item">
  <p class="project-index__kicker">
    <span>{year}</span>
    <span class="project-index__status">{statusLabel}</span>
  </p>

  <div class="project-index__body">
    <h3 class="project-index__title">
      <a href={`/projects/${slug}`}>{title}</a>
    </h3>
    <p class="project-index__summary">{summary}</p>
    {techStack.length > 0 && (
      <p class="project-index__stack">
        <span class="visually-hidden">Technology stack: </span>
        {techStack.join(' · ')}
      </p>
    )}
  </div>
</article>

<style>
  .project-index__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-index__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .project-index__status {
    color: var(--color-text-muted);
  }

  .project-index__status::before {
    content: '·';
    margin-right: 0.5rem;
  }

  .project-index__body {
    min-width: 0;
    max-width: 46rem;
  }

  .project-index__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .project-index__title a {
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .project-index__title a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .project-index__summary {
    margin: 0 0 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .project-index__stack {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .project-index__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 2rem;
      padding: 1.75rem 0;
    }

    .project-index__kicker {
      flex-direction: column;
      padding-top: 0.45rem;
    }

    .project-index__status::before {
      content: none;
    }

    .project-index__summary {
      font-size: 1.125rem;
    }
  }
</style>
