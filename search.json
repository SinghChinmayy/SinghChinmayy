---
layout: none
---
[
{% assign all_docs = site.posts %}
{% for doc in all_docs %}
  {
    "title": {{ doc.title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "date": "{{ doc.date }}",
    "content": {{ doc.content | strip_html | strip_newlines | jsonify }},
    "type": "Blog"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
] 